####################################################################################
# Crown Clash — environment
#
# Copy to `.env` for local development:   cp .env.example .env
#
# Every variable below has a working dev default baked into `apps/server/src/lib/env.ts`,
# so `pnpm dev` runs with an empty file. Only DATABASE_URL genuinely needs a service
# behind it — Redis is optional and degrades to an in-process fallback.
#
# In production the process REFUSES TO START if AUTH_SECRET or COOKIE_SECRET is still
# the dev default. That is intentional: a shipped default JWT key hands out every
# account in the database.
#
# Note: `prisma` reads DATABASE_URL from this file's copy at the repo root, so
# `npx prisma validate|migrate|generate` need `.env` to exist even though the server
# itself would start without it.
####################################################################################

# ---------------------------------------------------------------------------- core
# development | test | production
NODE_ENV=development
PORT=8080
# 0.0.0.0 behind nginx; 127.0.0.1 if nginx and the API share a host and you want the
# API unreachable from outside.
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ------------------------------------------------------------------------ postgres
# Prisma connection string. `prisma migrate deploy` reads the same variable.
DATABASE_URL=postgresql://crown:crown@localhost:5432/crown?schema=public

# --------------------------------------------------------------------------- redis
# OPTIONAL. Unset ⇒ an in-memory implementation of the handful of commands the server
# uses (leaderboard cache, rate-limit store, worker job stream, Phase-2 matchmaking
# sorted set). That fallback is per-process, so it is correct for one dev machine and
# WRONG for several PM2 instances — always set this in production.
# REDIS_URL=redis://127.0.0.1:6379

# --------------------------------------------------------------------------- auth
# HS256 signing key for the session JWT. Minimum 16 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-only-auth-secret-change-me-32ch
# Signing key for @fastify/cookie. Independent from AUTH_SECRET on purpose.
COOKIE_SECRET=dev-only-cookie-secret-change-me
# Cookie name the client's fetch wrapper never reads — it is httpOnly.
COOKIE_NAME=cc_session
# Set to your apex domain in production so the cookie survives www/api subdomains,
# e.g. `.crownclash.gg`. Leave unset for localhost.
# COOKIE_DOMAIN=.example.com
# Session lifetime. There is no refresh flow; the cookie is re-issued on each login.
SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------- cors
# Comma-separated exact origins. `*` is illegal with credentialed requests, and every
# request here carries the session cookie.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# -------------------------------------------------------------------- wallet / SIWE
# MUST equal the host the client page is served from, or wallets will refuse to sign
# and verification will reject the message. Host[:port], no scheme.
SIWE_DOMAIN=localhost:5173
# Full origin, with scheme.
SIWE_URI=http://localhost:5173
# EIP-155 chain id embedded in the SIWE message. 1 = Ethereum mainnet.
SIWE_CHAIN_ID=1
# Human-readable line shown in the wallet's signing prompt (both chains).
SIWE_STATEMENT=Link this wallet to your Crown Clash account.
# Single-use challenge lifetime. Short is good: it bounds the replay window even
# before the nonce is consumed.
WALLET_NONCE_TTL_SEC=300

# --------------------------------------------------------------------- rate limits
# Per-user limits from handoff §5 (match start 1/10s, chest open 1/2s, save write
# 1/5s). Turn off only for local load experiments — never in production.
RATE_LIMIT_ENABLED=true
# Read the client IP from X-Forwarded-For. True behind nginx/Cloudflare; false if the
# API is exposed directly, or anonymous callers can spoof their rate-limit key.
TRUST_PROXY=true

# -------------------------------------------------------------------------- worker
# Cadence of the second PM2 process: audit re-simulation, leaderboard snapshot, and
# reaping.
WORKER_TICK_MS=15000
# A match started and never submitted is voided after this long. Also the window in
# which a client may legitimately be mid-battle — a match is 3 minutes plus overtime,
# so anything under ~6 would void honest slow connections.
MATCH_EXPIRY_MINUTES=15
# Leaderboard cache TTL. The worker refreshes it on its own tick, so this mostly
# governs how stale a read can be if the worker is down.
LEADERBOARD_TTL_SEC=30

# --------------------------------------------------------------------------- misc
# Largest request body the API will parse. A legal deploy log is ~15 KB at worst.
BODY_LIMIT_BYTES=262144
# Optional: serve the built client from the API process instead of nginx. Point at
# `apps/web/dist`. Leave unset when nginx serves static files.
# STATIC_DIR=/var/www/crown-clash/web

# Server-local timezone. `dayKey()` decides quest resets and login streaks in LOCAL
# time, so every instance must agree on where midnight is.
TZ=UTC
