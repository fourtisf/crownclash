{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // rootDir "." keeps the emitted layout at dist/src/*, which is what ecosystem.config.js
    // and the package scripts point at.
    "rootDir": ".",
    "noEmit": false,
    // Cleared on purpose: typecheck resolves @crown/shared to source so it works on a clean
    // checkout, but the *build* must resolve it through the package's exports to the compiled
    // dist. pnpm -r builds in topological order, so shared is always built first.
    "paths": {}
  },
  "include": ["src/**/*.ts"]
}
