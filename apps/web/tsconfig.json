{
  // This project checks the client and its vitest suite. Two things are deliberately outside it.
  //
  // `test/e2e` — test/e2e/server.ts imports ../../../server/src/app.js to boot a real Fastify
  // instance, which drags all of apps/server into this program without apps/server's own
  // tsconfig. Two things then break: apps/server/src/fastify.d.ts (which augments
  // FastifyInstance with `store`/`redis` and FastifyRequest with `userId`) is not part of this
  // project, so every use of those decorators becomes TS2339; and @types/node is not resolvable
  // from apps/web at all. The result is ~24 errors in files this package does not own and a red
  // `pnpm -r typecheck`. Server code is checked by apps/server/tsconfig.json, which has the
  // ambient declarations and the node types; Playwright typechecks its own specs when it runs.
  //
  // `*.config.ts` — vite/vitest/playwright configs import node: builtins, and @types/node is
  // not a dependency of this package.
  //
  // test/*.test.ts IS included: excluding the whole of test/ to dodge test/e2e would also stop
  // typechecking fx.test.ts, which is client code and the only unit test this package has.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "declaration": false,
    "allowJs": false,
    // Mirrors the alias in vite.config.ts and vitest.config.ts so the editor, the typechecker,
    // the test runner and the bundler all resolve the shared game to the same source file.
    "paths": { "@crown/shared": ["../../packages/shared/src/index.ts"] }
  },
  "include": ["src", "test"],
  "exclude": ["test/e2e"]
}
